ANYAICAM_ENV=staging
ANYAICAM_RUNTIME_ROLE=cloud
ANYAICAM_VERSION=0.9.1
ANYAICAM_BUILD_ID=replace-with-git-sha
WEB_CONCURRENCY=2

ANYAICAM_PUBLIC_URL=https://staging.example.com
ANYAICAM_PHONE_URL=https://staging.example.com
ANYAICAM_FORCE_HTTPS=true
ANYAICAM_TRUST_PROXY_HEADERS=true
ANYAICAM_SECURE_COOKIES=true

ANYAICAM_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/anyaicam
AWS_REGION=us-east-1
ANYAICAM_S3_BUCKET=replace-me
ANYAICAM_S3_PREFIX=anyaicam/staging
ANYAICAM_SES_SENDER=no-reply@example.com
ANYAICAM_SECRETS_SECRET_ID=anyaicam/staging/application
ANYAICAM_CLOUDFRONT_URL=https://replace-me.cloudfront.net

ANYAICAM_CLOUD_UPLOAD_ENABLED=false
ANYAICAM_CLOUD_UPLOAD_MAX_RETRIES=5
ANYAICAM_CLOUD_UPLOAD_RETRY_SECONDS=60

ANYAICAM_PORTAL_SECRET=inject-with-secrets-manager
ANYAICAM_ADMIN_EMAIL=admin@example.com
ANYAICAM_ADMIN_PASSWORD=inject-with-secrets-manager

ANYAICAM_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
ANYAICAM_SMTP_PORT=587
ANYAICAM_SMTP_USERNAME=inject-with-secrets-manager
ANYAICAM_SMTP_PASSWORD=inject-with-secrets-manager
ANYAICAM_SMTP_FROM=no-reply@example.com
ANYAICAM_SMTP_USE_TLS=true
