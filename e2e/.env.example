# AnyAiCam e2e (Playwright) local credentials template.
#
# Copy this file to `e2e/.env` (that exact filename is already git-ignored
# -- see .gitignore's own `.env` and `e2e/.env` rules) and fill in real
# values there. NEVER put real values in this .example file, NEVER commit
# e2e/.env, and NEVER paste these values into chat/source code -- this
# file is the one and only place they belong locally.
#
# ANYAICAM_E2E_BASE_URL defaults to staging if unset -- see conftest.py.
# Only ever point this at staging unless ANYAICAM_E2E_ALLOW_PRODUCTION is
# also explicitly set (see that variable's own comment below): conftest.py
# hard-fails the whole run rather than silently letting a test touch
# production.
ANYAICAM_E2E_BASE_URL=https://portal-staging.anyaicam.com

# A dedicated staging test-tenant login -- NOT the real pilot customer's
# own credentials. See docs/AUTONOMOUS_VALIDATION_PERMISSIONS.md for why
# a separate synthetic test identity is required before any authenticated
# e2e test is allowed to run.
ANYAICAM_E2E_USERNAME=
ANYAICAM_E2E_PASSWORD=

# Safety rail, not a convenience switch: conftest.py refuses to run ANY
# test against a base_url containing the real production domain unless
# this is explicitly set to "true". Leave unset/false for all normal use;
# only a human, deliberately, ever sets this to true, and only for an
# already-authorized read-only inspection pass -- never for automated
# modification.
ANYAICAM_E2E_ALLOW_PRODUCTION=false
