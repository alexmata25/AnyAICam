# Audio assets are binary: never line-ending converted (core.autocrlf on
# Windows dev machines), so a published file matches its checked-in hash.
*.wav binary

# Linux installer and runtime shell scripts must remain LF-only on every
# developer checkout, regardless of core.autocrlf on Windows.
*.sh text eol=lf

# Dockerfile.production predates the LF policy and is stored with CRLF; tell
# diff checks that its CR is a line terminator rather than trailing content.
Dockerfile.production whitespace=cr-at-eol
