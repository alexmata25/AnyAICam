ANYAICAM_ENV=staging
ANYAICAM_APP_SECRETS=replace-current-secret,replace-previous-secret
ANYAICAM_DATABASE_BACKEND=postgresql
ANYAICAM_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ANYAICAM_PUBLIC_PORTAL_URL=https://portal-staging.anyaicam.com
ANYAICAM_APPLIANCE_API_URL=https://portal-staging.anyaicam.com
ANYAICAM_PUBLIC_WEBSITE_URL=https://staging.anyaicam.com
ANYAICAM_PORTAL_URL=https://portal-staging.anyaicam.com
ANYAICAM_API_BASE_URL=https://portal-staging.anyaicam.com/api/v1
ANYAICAM_PASSWORD_RESET_URL=https://portal-staging.anyaicam.com/reset-password
ANYAICAM_INVITATION_URL=https://portal-staging.anyaicam.com/partner.html
ANYAICAM_APPLIANCE_ACTIVATION_URL=https://portal-staging.anyaicam.com/api/appliance/activate
ANYAICAM_STAGING_PARTNER_URL=https://portal-staging.anyaicam.com/partner.html
ANYAICAM_STAGING_CUSTOMER_URL=https://portal-staging.anyaicam.com/customer-login.html
ANYAICAM_ALLOWED_ORIGINS=https://staging.anyaicam.com,https://portal-staging.anyaicam.com
ANYAICAM_TRUSTED_HOSTS=staging.anyaicam.com,portal-staging.anyaicam.com
ANYAICAM_STORAGE_BACKEND=s3
ANYAICAM_S3_ENDPOINT=https://s3-compatible-endpoint.example
ANYAICAM_S3_BUCKET=replace-staging-bucket
ANYAICAM_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
ANYAICAM_EMAIL_BACKEND=preview
ANYAICAM_EMAIL_PREVIEW_DIR=/app/recordings/email-preview
ANYAICAM_LOG_LEVEL=INFO
ANYAICAM_LOG_FORMAT=json
ANYAICAM_HTTPS_ONLY=true
ANYAICAM_SECURE_COOKIES=true
ANYAICAM_COOKIE_DOMAIN=.anyaicam.com
ANYAICAM_CSRF_ENABLED=true

# 2026-09-15 (analytics-sync staging validation): appliance_cloud.py's
# ANALYTICS_SYNC_ENABLED reads this and defaults to false -- when false,
# POST /api/appliance/analytics/{camera_id}/events 404s ("Analytics sync
# is not enabled.") for every camera uniformly, not just a pilot subset
# (confirmed live: camera 1's own analytics events 404 identically to
# cameras 2-5's). This was the actual root cause of "Playback markers
# have no real event data to test against" -- unrelated to camera
# discovery/recording, which was already healthy for all 5 channels.
# Manually verified true on anyaicam-staging (portal-green,
# deploy-portal:865e49d) before being captured here; recreating the
# staging container from this file alone does not retroactively change
# a container already running with this value set -- see this same-
# dated entry in docs/PROJECT_CHECKPOINT.md for the investigation and
# validation history.
#
# Recording upload for Cameras 2-5 stays intentionally pilot-gated --
# do NOT add ANYAICAM_RECORDING_UPLOAD_ENABLED or ANYAICAM_RECORDING_
# UPLOAD_PILOT_CAMERAS here without separate, explicit authorization;
# this flag only governs analytics-event sync, a deliberately
# independent toggle (see analytics_sync.py's own module docstring).
ANYAICAM_ANALYTICS_SYNC_ENABLED=true

# Stripe TEST/SANDBOX hardware Price IDs -- one-time purchases (Ryzen
# appliances, Numato relay module), see app/hardware_orders.py. These are
# real Stripe TEST-mode Price IDs (Price IDs are not secrets), confirmed
# by the site owner -- NEVER copy these into a live/production env file.
# ANYAICAM_STRIPE_SECRET_KEY itself must also be a sk_test_... key in
# this staging environment, never the live sk_live_... key, for these to
# resolve against the right Stripe mode.
ANYAICAM_STRIPE_PRICE_RYZEN_STARTER=price_1UDnklGllhK80H2nBAHTk6ZP
ANYAICAM_STRIPE_PRICE_RYZEN_ENTERPRISE=price_1UDnmeGllhK80H2nshtCoJD5
# AAC Facial Recognition appliance -- correct model label is "MINISFORUM
# AI X1 Pro-470", never "AI X1-255" (that name belongs to Ryzen Starter).
ANYAICAM_STRIPE_PRICE_RYZEN_AAC_FACIAL=price_1UDnnyGllhK80H2nlbwTWX69
ANYAICAM_STRIPE_PRICE_RELAY_NUMATO_3CH=price_1UDnpkGllhK80H2n2EA2lFmQ

# Provisioning Phase 8: hardware fulfillment/return business terms -- see
# hardware_fulfillment.py / hardware_returns.py.
#
# APPROVED: preparation/shipping timeframe shown to customers ("Please
# allow up to 14 days for preparation and shipment.").
ANYAICAM_HARDWARE_PREPARATION_MAX_DAYS=14
#
# APPROVED (this pass): a 15% restocking fee applies to an eligible
# hardware return, EXCEPT when hardware_returns.record_inspection_and_
# calculate_refund()'s defective_or_damaged_on_arrival flag is set for
# that return (defective due to AnyAiCam, or arrived damaged) -- that
# exception waives the fee entirely regardless of this percentage. STILL
# STAGING ONLY -- do not carry this value into a live/production env
# file until the policy has completed legal review and Alejandro has
# separately approved publishing it.
ANYAICAM_HARDWARE_RESTOCKING_PERCENT=15
#
# APPROVED (this pass): customers have 30 days (from delivery, or from
# shipment if delivery date is unknown) to request an eligible hardware
# return -- see hardware_returns.request_return()'s enforcement. Same
# staging-only caveat as above.
ANYAICAM_HARDWARE_RETURN_WINDOW_DAYS=30
