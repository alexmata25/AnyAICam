ANYAICAM_ENV=production
ANYAICAM_APP_SECRETS=REPLACE_CURRENT_SECRET,REPLACE_PREVIOUS_SECRET_DURING_ROTATION
ANYAICAM_DATABASE_BACKEND=postgresql
ANYAICAM_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ANYAICAM_PUBLIC_PORTAL_URL=https://portal.anyaicam.com
ANYAICAM_APPLIANCE_API_URL=https://portal.anyaicam.com
ANYAICAM_PUBLIC_WEBSITE_URL=https://anyaicam.com
ANYAICAM_PORTAL_URL=https://portal.anyaicam.com
ANYAICAM_API_BASE_URL=https://portal.anyaicam.com/api/v1
ANYAICAM_PASSWORD_RESET_URL=https://portal.anyaicam.com/reset-password
ANYAICAM_INVITATION_URL=https://portal.anyaicam.com/partner.html
ANYAICAM_APPLIANCE_ACTIVATION_URL=https://portal.anyaicam.com/api/appliance/activate
ANYAICAM_ALLOWED_ORIGINS=https://anyaicam.com,https://www.anyaicam.com,https://portal.anyaicam.com
ANYAICAM_TRUSTED_HOSTS=anyaicam.com,www.anyaicam.com,portal.anyaicam.com
ANYAICAM_PRODUCTION_PARTNER_URL=https://portal.anyaicam.com/partner.html
ANYAICAM_PRODUCTION_CUSTOMER_URL=https://portal.anyaicam.com/customer-login.html
ANYAICAM_STORAGE_BACKEND=s3
ANYAICAM_S3_ENDPOINT=https://s3-compatible-endpoint.example
ANYAICAM_S3_BUCKET=REPLACE_BUCKET
ANYAICAM_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
ANYAICAM_EMAIL_BACKEND=smtp
ANYAICAM_SMTP_HOST=smtp.example.com
ANYAICAM_SMTP_PORT=587
ANYAICAM_SMTP_USERNAME=REPLACE_ME
ANYAICAM_SMTP_PASSWORD=REPLACE_ME
ANYAICAM_EMAIL_FROM=no-reply@example.com
ANYAICAM_LOG_LEVEL=INFO
ANYAICAM_LOG_FORMAT=json
ANYAICAM_HTTPS_ONLY=true
ANYAICAM_SECURE_COOKIES=true
ANYAICAM_COOKIE_DOMAIN=.anyaicam.com
ANYAICAM_CSRF_ENABLED=true
ANYAICAM_LOGIN_ATTEMPT_LIMIT=5
ANYAICAM_LOGIN_LOCKOUT_MINUTES=15
ANYAICAM_MEDIA_RETENTION_DAYS=365
ANYAICAM_AUDIT_RETENTION_DAYS=2555
