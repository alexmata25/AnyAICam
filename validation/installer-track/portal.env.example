# PREPARED ONLY. Not deployable until approval, isolation and NEW secrets.
# "production" selects security behavior in an ISOLATED guest only.
ANYAICAM_ENV=production
ANYAICAM_RUNTIME_ROLE=cloud
ANYAICAM_DATABASE_BACKEND=sqlite
ANYAICAM_PARTNER_DB=/var/lib/anyaicam-installer-test/portal.db
ANYAICAM_PUBLIC_PORTAL_URL=https://installer-test.test
ANYAICAM_PORTAL_URL=https://installer-test.test
PUBLIC_BASE_URL=https://installer-test.test
ANYAICAM_ALLOWED_ORIGINS=https://installer-test.test
ANYAICAM_TRUSTED_HOSTS=installer-test.test
ANYAICAM_CSRF_ENABLED=true
ANYAICAM_HTTPS_ONLY=true
ANYAICAM_SECURE_COOKIES=true
# Generate new session/app keys and a Fernet claim-flow key in the guest.
# Never copy production/staging .env, databases, credentials or certificates.
# Payment, email, SMS and AWS credentials remain unset.
# Required newly generated secrets at future provisioning:
# ANYAICAM_APP_SECRETS=<new app/session signing secrets>
# ANYAICAM_PORTAL_SECRET=<new portal signing secret>
# ANYAICAM_CLAIM_FLOW_SECRET_KEY=<new Fernet key>
