{
  "id": "/customer-portal",
  "name": "AnyAiCam Customer Portal",
  "short_name": "AnyAiCam",
  "description": "Secure access to AnyAiCam cameras, alerts, sites, playback authorization, health, and account settings.",
  "start_url": "/customer-portal?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#11162d",
  "theme_color": "#11162d",
  "orientation": "any",
  "icons": [
    {"src": "/static/brand-icon.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "/static/brand-icon.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "shortcuts": [
    {"name": "Cameras", "url": "/customer-portal?page=cameras", "icons": [{"src": "/static/brand-icon.png", "sizes": "192x192"}]},
    {"name": "Alerts", "url": "/customer-portal?page=alerts", "icons": [{"src": "/static/brand-icon.png", "sizes": "192x192"}]}
  ]
}
