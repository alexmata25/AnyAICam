<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Customer Login | ANY AI CAM</title>
<style>
:root{--navy:#10162d;--blue:#5360df;--pink:#bd2b90}*{box-sizing:border-box}body{margin:0;font-family:Inter,Segoe UI,Arial;background:#eef3f9;color:#17233e}.head{display:flex;justify-content:space-between;align-items:center;padding:14px clamp(16px,5vw,64px);background:#fff}.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--navy);font-weight:900}.brand img{width:50px}.head nav{display:flex;gap:16px;align-items:center;flex-wrap:wrap}.head nav a{text-decoration:none;font-weight:700}.logout{display:none;border:1px solid #aab7ca;border-radius:999px;padding:8px 12px;background:#fff;font-weight:700}.hero{min-height:calc(100vh - 160px);display:grid;grid-template-columns:1fr minmax(320px,470px);gap:40px;align-items:center;padding:clamp(35px,8vw,90px) max(16px,calc((100vw - 1160px)/2));background:radial-gradient(circle at 15% 20%,rgba(189,43,144,.28),transparent 34%),linear-gradient(135deg,#10162d,#252d65);color:#fff}.hero h1{font-size:clamp(2.3rem,5vw,4.5rem);margin:.4rem 0}.hero p{color:#d8e2ff;line-height:1.7}.card{background:#fff;color:#17233e;padding:28px;border-radius:20px;box-shadow:0 20px 60px #05091a55}.card form{display:grid;gap:14px}.card label{display:grid;gap:5px;font-weight:700}.card input{padding:12px;border:1px solid #aab7ca;border-radius:9px;font:inherit}.password{position:relative}.password input{width:100%;padding-right:70px}.password button{position:absolute;right:5px;top:5px;padding:7px;border:0;border-radius:7px}.submit{border:0;border-radius:999px;padding:12px;background:linear-gradient(135deg,var(--pink),var(--blue));color:#fff;font-weight:900}.message{display:none;padding:10px;background:#ffe8ec;color:#8b1730;border-radius:8px}footer{padding:22px;text-align:center;background:#0b1025;color:#dbe4fa}@media(max-width:760px){.hero{grid-template-columns:1fr}.head{align-items:flex-start}.head nav{justify-content:flex-end}}
</style>
</head>
<body>
<header class="head"><a class="brand" href="/"><img src="/static/brand-icon.png" alt="AnyAiCam">ANY AI CAM</a><nav><a id="partner-nav" href="/partner.html">Partner Login</a><a id="customer-nav" href="/customer-login.html">Customer Login</a><a href="/support">Support</a><button id="logout" class="logout">Logout</button></nav></header>
<main class="hero"><section><small>CUSTOMER PORTAL</small><h1>Your cameras, recordings, and alerts in one place.</h1><p>Securely switch between sites, review authorized video, monitor camera and appliance health, and manage your AnyAiCam plan from computers, tablets, and mobile browsers.</p><p>Video is delivered through the AnyAiCam appliance architecture—not directly from your browser to private camera addresses.</p></section><section class="card"><h2>Customer sign in</h2><form id="login"><label>Email<input id="email" type="email" autocomplete="username" required></label><label>Password<div class="password"><input id="password" type="password" autocomplete="current-password" required><button id="show" type="button">Show</button></div></label><div id="message" class="message"></div><button class="submit">Sign in</button><a href="/forgot-password">Forgot password?</a></form></section></main>
<footer>© 2026 ANY AI CAM · Secure customer access</footer>
<script>
const csrf=()=>document.cookie.split('; ').find(x=>x.startsWith('anyaicam_csrf='))?.split('=')[1]||'';
let publicNavigation={partner_url:'/partner.html',customer_url:'/customer-login.html'};
document.getElementById('show').onclick=()=>{const p=document.getElementById('password');p.type=p.type==='password'?'text':'password';document.getElementById('show').textContent=p.type==='password'?'Show':'Hide'};
document.getElementById('login').onsubmit=async e=>{e.preventDefault();const response=await fetch('/api/partner-login',{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':csrf()},body:JSON.stringify({email:document.getElementById('email').value,password:document.getElementById('password').value,customer_only:true})});if(response.ok){location.href=response.url;return}const result=await response.json();const box=document.getElementById('message');box.textContent=result.detail||'Sign-in failed.';box.style.display='block'};
document.getElementById('logout').onclick=async()=>{await fetch('/partner-logout',{method:'POST',headers:{'X-CSRF-Token':csrf()}});location.href=publicNavigation.customer_url};
fetch('/api/website/partner-session').then(r=>r.json()).then(session=>{publicNavigation=session;document.getElementById('partner-nav').href=session.partner_url;document.getElementById('customer-nav').href=session.customer_url;if(!session.authenticated)return;const link=document.getElementById(session.experience==='partner'?'partner-nav':'customer-nav');link.textContent=session.navigation_label;link.href=session.portal_url;document.getElementById('logout').style.display='inline-block';if(session.experience==='customer')document.getElementById('login').closest('.card').style.display='none'}).catch(()=>{});
</script>
</body></html>
