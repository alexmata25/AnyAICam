{
  "id": "/partner.html",
  "name": "ANY AI CAM Partner Portal",
  "short_name": "ANY AI CAM",
  "description": "Private ANY AI CAM partner dashboard for quotes, referrals, QR codes, customer setup, orders, and commissions.",
  "start_url": "/partner.html?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070d25",
  "theme_color": "#0b1332",
  "categories": ["business", "productivity"],
  "icons": [
    {"src":"/partner-icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},
    {"src":"/partner-icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"},
    {"src":"/partner-icon-maskable-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}
  ],
  "shortcuts": [
    {
      "name": "New Quote",
      "short_name": "New Quote",
      "url": "/partner.html?action=new-quote",
      "icons": [{"src":"/partner-icon-192.png","sizes":"192x192","type":"image/png"}]
    },
    {
      "name": "Show Referral QR",
      "short_name": "My QR",
      "url": "/partner.html?action=qr",
      "icons": [{"src":"/partner-icon-192.png","sizes":"192x192","type":"image/png"}]
    }
  ]
}
