[Unit]
Description=AnyAiCam VMS (Docker Compose)
After=docker.service network-online.target anyaicam-webrtc-firewall.service
Requires=docker.service
Wants=network-online.target anyaicam-webrtc-firewall.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/anyaicam
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
